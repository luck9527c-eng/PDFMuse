{
  "name": "pdfmuse",
  "version": "0.1.0",
  "private": true,
  "description": "A portable AI-assisted PDF reading workspace",
  "type": "module",
  "main": "dist-electron/src/main/main.js",
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "dev": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5273 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5273 electron .\"",
    "dev:web": "vite --host 127.0.0.1",
    "test": "vitest run",
    "test:watch": "vitest",
    "smoke:electron": "node scripts/smoke-electron.mjs",
    "prepare:mineru": "node scripts/prepare-mineru-runtime.mjs",
    "ab:mineru": "node scripts/ab-mineru.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.renderer.json && tsc --noEmit -p tsconfig.electron.json",
    "build": "npm run clean && npm run typecheck && vite build && tsc -p tsconfig.electron.json",
    "package:installer": "npm run prepare:mineru && npm run build && electron-builder --win nsis"
  },
  "dependencies": {
    "@napi-rs/canvas": "^1.0.8",
    "@openclaw/ai": "2026.8.1",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-tooltip": "^1.2.8",
    "dompurify": "^3.4.14",
    "katex": "^0.18.5",
    "lucide-react": "^0.544.0",
    "marked": "^18.0.11",
    "pdfjs-dist": "6.2.108",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "typebox": "1.3.18"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "concurrently": "^9.2.1",
    "cross-env": "^10.0.0",
    "electron": "44.1.0",
    "electron-builder": "^26.0.12",
    "jsdom": "^30.0.1",
    "typescript": "^5.9.2",
    "vite": "^7.1.3",
    "vitest": "^3.2.4",
    "wait-on": "^8.0.4"
  },
  "build": {
    "appId": "com.pdfmuse.app",
    "productName": "PDFMuse",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "dist-electron/**",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources",
        "to": ".",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": [
        "portable",
        "nsis"
      ],
      "signAndEditExecutable": false,
      "artifactName": "PDFMuse-${version}-portable.${ext}"
    }
  },
  "allowScripts": {
    "electron": true,
    "electron-winstaller": true,
    "esbuild": true
  }
}
